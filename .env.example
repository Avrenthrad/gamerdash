# Copy this file to .env and fill in real values.
#
# IMPORTANT: most of these are NOT prefixed VITE_. Vite only ships
# VITE_-prefixed variables to the browser — the unprefixed ones are
# read by the serverless functions in /api, which run on Vercel's
# servers, so those key values never reach the public website's
# JavaScript. The two Supabase ones ARE meant to be public (their
# "anon" key relies on database-level Row Level Security, not
# secrecy), so those two specifically use the VITE_ prefix on purpose.

# Steam Web API key — get one instantly (no approval wait) at:
# https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# PlatPrices API key (PlayStation Store prices) — apply at:
# https://platprices.com/api-request
PLATPRICES_KEY=

# XBXprices API key (Xbox/Microsoft Store prices) — apply at:
# https://xbxprices.com
XBXPRICES_KEY=

# Bungie API (Destiny 2 Eververse store) — parked until deployed:
# needs a real public redirect URL to register at bungie.net/en/Application
BUNGIE_API_KEY=
BUNGIE_CLIENT_ID=
BUNGIE_CLIENT_SECRET=

# RAWG (Upcoming Releases — new games and DLC/expansions across every
# platform, real official API) — free signup at rawg.io/apidocs.
# NOTE: their free tier requires attribution (a visible link back to
# RAWG wherever the data shows) — already built into the page, don't
# remove it if you're editing UpcomingReleasesPage.jsx.
RAWG_KEY=

# TMDB (Entertainment College — real movie/TV search and tracking) —
# free signup at themoviedb.org/signup, then Settings > API. Free for
# non-commercial use; their terms require displaying the TMDB logo
# specifically for attribution (a text-link placeholder is used for
# now until a real logo asset is added).
TMDB_API_KEY=

# Supabase — real accounts + persistence. Create a free project at
# supabase.com, then Settings > API for these two values. Also run
# supabase/schema.sql once in the SQL Editor before this will work.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Only needed for packaged desktop (Tauri) / mobile (Capacitor) builds
# — leave blank for the normal website, where relative /api/ paths
# already work correctly. Once deployed, set this to the real URL,
# e.g. https://lykodex.vercel.app — see PACKAGING.md for why.
VITE_API_BASE_URL=
