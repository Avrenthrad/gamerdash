{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lykodex",
  "version": "0.1.0",
  "identifier": "com.lykodex.app",
  "build": {
    "beforeDevCommand": "vercel dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lykodex",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Avrenthrad/gamerdash/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFGQ0ZENEJBQUJBRkE4NTEKUldSUnFLK3J1dFRQSHd4cm9kajBjbGNxQS9OdzhxbmdJdlk0ODMzTHJYUVFhMFVybGswZXNySlAK"
    },
    "deep-link": {
      "desktop": {
        "schemes": ["lykodex"]
      }
    }
  }
}
