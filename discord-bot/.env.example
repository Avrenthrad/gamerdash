# Copy to .env and fill in real values.

# Discord Developer Portal (discord.com/developers/applications) —
# either your existing Lykodex OAuth application, or a new one:
#   1. Go to the "Bot" tab, click "Add Bot" if there isn't one yet
#   2. Copy the bot token here
#   3. On the same Bot tab, toggle ON BOTH "Presence Intent" AND
#      "Server Members Intent" under "Privileged Gateway Intents" —
#      the bot uses both, and the gateway connection fails outright
#      ("Used disallowed intents") if either one is off
DISCORD_BOT_TOKEN=

# Same Supabase project as the main app — but this is the
# service_role key specifically (Settings > API), NOT the anon key.
# This key bypasses Row Level Security entirely. It must only ever
# live here, in this bot's own environment — never in the main app,
# never in anything that reaches a browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional — the deployed Lykodex site, used only by the daily Gaming
# Mastery refresh to reach the real Steam Web API through the site's
# own /api/steam proxy, so this bot doesn't need its own separate
# STEAM_API_KEY. Defaults to the production deployment if left blank.
SITE_BASE_URL=https://gamerdash.vercel.app
