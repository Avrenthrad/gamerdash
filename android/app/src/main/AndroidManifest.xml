<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Catches the lykodex://auth-callback redirect Supabase
                 OAuth (Google, etc.) sends the app back to after
                 opening sign-in in an external browser tab — see
                 lib/oauthRedirect.js, which reads this via Capacitor's
                 appUrlOpen event. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="lykodex" android:host="auth-callback" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Needed for the TCG "Live scan" feature's getUserMedia() camera
         stream (see TcgVisualScanner.jsx). Capacitor's own
         BridgeWebChromeClient (wired up automatically by Bridge.java)
         already handles requesting this at runtime and granting the
         WebView's video-capture permission once granted — this
         manifest declaration is the one piece that isn't automatic:
         without it, Android refuses the runtime permission request
         outright regardless of what the WebView asks for. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- Requested upfront alongside Camera (see lib/requestPermissions.js)
         even though no feature reads real location data yet — same
         BridgeWebChromeClient plumbing (onGeolocationPermissionsShowPrompt)
         handles the runtime request when navigator.geolocation is called
         from JS, same as onPermissionRequest does for the camera. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
</manifest>
