.env
.env.local
.env.*.local
discord-bot/.env
node_modules/
discord-bot/node_modules/
dist/
dist-ssr/
*.local
src-tauri/target/
android/.gradle/
android/app/build/
android/build/
android/*/build/
ios/App/build/
ios/App/Pods/
